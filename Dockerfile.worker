FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 XCOMIFY_WORKER=false
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock \
    && groupadd --gid 10001 xcomify \
    && useradd --uid 10001 --gid 10001 --create-home xcomify
COPY --chown=10001:10001 xcomify /app/xcomify
USER 10001:10001
CMD ["python", "-m", "xcomify.cloud_worker"]
