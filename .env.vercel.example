# PLACEHOLDERS ONLY. Set private values in Vercel production environment settings.
# Use a separate project/database for staging. This profile rejects Preview.
XCOMIFY_ENV=production
XCOMIFY_WORKER=false
XCOMIFY_DEMO=false
XCOMIFY_BASE_URL=https://YOUR-APP-DOMAIN
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DATABASE-HOST/DATABASE?sslmode=require
XCOMIFY_ENCRYPTION_KEY=GENERATE_ON_YOUR_COMPUTER
XCOMIFY_BOOTSTRAP_TOKEN=GENERATE_ON_YOUR_COMPUTER
# Optional until you connect real private Google Sheets:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# /tmp is scratch, NOT a database, secret or backup store.
