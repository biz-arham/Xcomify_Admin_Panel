# Copy to .env only when configuring integration/hosting. Never share a filled .env.
XCOMIFY_ENV=local
XCOMIFY_BASE_URL=http://localhost:8787
XCOMIFY_WORKER=true
# Real data defaults to .data; demo to .data-demo. Never point demo at real data.
# XCOMIFY_DATA_DIR=/absolute/private/folder
# DATABASE_URL=sqlite:////absolute/private/folder/xcomify.db
# Owner authorizes these locally. Do not send client secrets in chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local keys/bootstrap code are generated automatically. Production MUST set these.
# XCOMIFY_ENCRYPTION_KEY=
# XCOMIFY_BOOTSTRAP_TOKEN=
# Production requires HTTPS and PostgreSQL (see infra/README.md).
